<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSMARCO-XI · Spoken AI Knowledge Scroll</title>
    <meta name="description" content="Lush Goa Heritage Spoken Voice RAG Agent powered by AI4Bharat MSMARCO-XI, FAISS vector search, and Gemini/Groq LLM.">
    <link rel="stylesheet" href="/static/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

    <!-- ============================================================
         BACKGROUND AMBIENT ATMOSPHERE (Deep Botanical Jungle)
    ============================================================= -->
    <div class="ambient-bg">
        <div class="ambient-glow ambient-glow--1"></div>
        <div class="ambient-glow ambient-glow--2"></div>
        <div class="palm-silhouette-left"></div>
        <div class="palm-silhouette-right"></div>
    </div>

    <!-- ============================================================
         1. PINNED SCROLL GATE HERO (Opens & Closes with Spindles)
    ============================================================= -->
    <div class="scroll-gate-section" id="scroll-unroll-hero">
        <div class="scroll-gate-container">
            
            <!-- TOP WOODEN ROLLER SPINDLE (Attached to top opening edge) -->
            <div class="spindle spindle--top" id="top-spindle">
                <div class="finial finial--left">
                    <div class="finial-cap"></div>
                    <div class="finial-body"></div>
                    <div class="finial-ring"></div>
                </div>
                <div class="spindle-rod">
                    <div class="rod-wood-grain"></div>
                    <div class="rod-rolled-paper">
                        <span class="rod-tag">MSMARCO‑XI · 2026</span>
                        <div class="rod-accent-line"></div>
                    </div>
                </div>
                <div class="finial finial--right">
                    <div class="finial-ring"></div>
                    <div class="finial-body"></div>
                    <div class="finial-cap"></div>
                </div>
            </div>

            <!-- PARCHMENT OPENING WINDOW (Expands/unrolls between spindles) -->
            <div class="parchment-gate-viewport" id="parchment-gate">
                <div class="deckle-edge deckle-edge--left"></div>
                <div class="deckle-edge deckle-edge--right"></div>
                
                <div class="parallax__layers" data-parallax-layers>
                    <div data-parallax-layer="1" class="parallax__layer parallax__layer--bg"></div>
                    <div data-parallax-layer="2" class="parallax__layer parallax__layer--grid"></div>
                    <div data-parallax-layer="3" class="parallax__layer-title">
                        <button id="hero-mic-btn" class="parallax__logo-icon" aria-label="Scroll to Voice Oracle" title="Click to scroll to Voice Oracle">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                            </svg>
                        </button>
                        <div class="hero-heritage-tag">
                            <span class="badge-gold">ai4bharat</span>
                            <span class="badge-accent">गोवा · RAG</span>
                            <span class="badge-gold">MSMARCO‑XI</span>
                        </div>
                        <h1 class="parallax__title">KNOWLEDGE <span class="title-accent-glow">ORACLE</span><br><span class="title-sub-row">OF THE SUNSHINE STATE</span></h1>
                        <p class="parallax__subtitle">Spoken Conversational Intelligence · Powered by Dense Vector Neural Retrieval</p>
                    </div>
                    <div data-parallax-layer="4" class="parallax__layer parallax__layer--fg"></div>
                </div>
            </div>

            <!-- BOTTOM WOODEN ROLLER SPINDLE (Attached to bottom opening edge) -->
            <div class="spindle spindle--bottom" id="bottom-spindle">
                <div class="finial finial--left">
                    <div class="finial-cap"></div>
                    <div class="finial-body"></div>
                    <div class="finial-ring"></div>
                </div>
                <div class="spindle-rod">
                    <div class="rod-wood-grain"></div>
                    <div class="rod-rolled-paper rod-rolled-paper--bottom">
                        <div class="rod-accent-line"></div>
                        <span class="rod-tag">SEA · SUN · SIGNAL · 2026</span>
                    </div>
                </div>
                <div class="finial finial--right">
                    <div class="finial-ring"></div>
                    <div class="finial-body"></div>
                    <div class="finial-cap"></div>
                </div>
            </div>

            <!-- Scroll unroll prompt CTA -->
            <div class="scroll-unroll-prompt" id="hero-scroll-cta" role="button" tabindex="0" title="Click to unroll the knowledge scroll">
                <span class="scroll-cta-label">Scroll to unroll the sanctuary</span>
                <div class="scroll-arrow-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M5 12l7 7 7-7"/>
                    </svg>
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================
         2. THE UNROLLED SANCTUARY (MAIN APP / ORACLE CHAMBER)
    ============================================================= -->
    <div class="scroll-viewport-container" id="main-app">
        <div class="parchment-body" id="parchment-content">
            <!-- Deckle Torn Edge Overlays -->
            <div class="deckle-edge deckle-edge--left"></div>
            <div class="deckle-edge deckle-edge--right"></div>

            <!-- PARCHMENT INNER CONTENT -->
            <div class="parchment-inner">

                <!-- 1. SCROLL HEADER BAR -->
                <header class="scroll-header">
                    <div class="header-stamp">
                        <span class="stamp-location">GOA, INDIA</span>
                        <span class="stamp-divider">·</span>
                        <span class="stamp-edition">SPOKEN KNOWLEDGE SCROLL</span>
                    </div>
                    <div class="header-actions">
                        <button id="clear-memory-btn" class="btn-royal-secondary" title="Reset conversational history">
                            Clear Memory
                        </button>
                        <div class="heritage-status-pill" id="system-status-pill">
                            <span class="status-gem pulse"></span>
                            <span id="status-text">System Active · 2000 Docs</span>
                        </div>