# MSMARCO-XI RAG Agent Configuration

# Dataset settings
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=default
DATASET_SPLIT=train
SAMPLE_SIZE=500

# Retrieval & Embeddings settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# Paths
VECTOR_STORE_PATH=data/index/faiss_index.bin
METADATA_STORE_PATH=data/index/metadata.pkl
PROCESSED_DATA_PATH=data/processed/english_sample.parquet

# LLM Provider Configuration
# Options: gemini, openai, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
GEMINI_API_KEY=

# Voice Configuration
# Options: google, openai, elevenlabs, sarvam
STT_PROVIDER=google
# Options: gtts, openai
TTS_PROVIDER=gtts
MEMORY_WINDOW=3

# Third-party Speech API Keys
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# Chunking Strategy Configuration
# Options: fixed, recursive, semantic, parent_child
CHUNK_STRATEGY=recursive

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
